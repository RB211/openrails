<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="ORTS.TrackViewer.Editing.WaitPointDialog"
        Title="Wait Point" SizeToContent="WidthAndHeight" CanResize="False">
    <Window.Styles>
        <Style Selector="TextBox">
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="Width" Value="48"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="Label">
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style Selector="StackPanel">
            <Setter Property="Spacing" Value="4"/>
        </Style>
    </Window.Styles>
    <StackPanel Orientation="Vertical" Margin="8">
        <StackPanel Orientation="Horizontal">
            <RadioButton GroupName="shuntingOption" Name="selectWait" VerticalAlignment="Center"
                         Content="Wait time: " IsCheckedChanged="Option_CheckChanged" MinWidth="120"/>
            <TextBox Name="waitTimeMinutes" KeyDown="OnKeyDownHandler" TextChanged="TwoDigits_TextChanged"/>
            <Label Content="minutes"/>
            <TextBox Name="waitTimeSeconds" KeyDown="OnKeyDownHandler" TextChanged="TwoDigits_TextChanged"/>
            <Label Content="seconds"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <Label Content="Openrails advanced shunting options:"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <RadioButton GroupName="shuntingOption" Name="selectUntil" VerticalAlignment="Center"
                         Content="Wait until:  " IsCheckedChanged="Option_CheckChanged" MinWidth="120"/>
            <TextBox Name="untilTimeHours" KeyDown="OnKeyDownHandler" TextChanged="TwoDigits_TextChanged"/>
            <Label Content=":"/>
            <TextBox Name="untilTimeMinutes" KeyDown="OnKeyDownHandler" TextChanged="TwoDigits_TextChanged"/>
            <Label Content="HH:MM"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <RadioButton GroupName="shuntingOption" Name="selectUncouple" VerticalAlignment="Center"
                         Content="Uncouple: keep " MinWidth="120" IsCheckedChanged="Option_CheckChanged" />
            <TextBox Name="uncoupleCars" KeyDown="OnKeyDownHandler" TextChanged="TwoDigits_TextChanged"/>
            <Label Content=" cars, and wait"/>
            <TextBox Name="uncoupleWaitSeconds" KeyDown="OnKeyDownHandler" TextChanged="TwoDigits_TextChanged"/>
            <Label Content="seconds. "/>
            <CheckBox Name="keepRear" VerticalAlignment="Center" Content="Keep rear" IsCheckedChanged="Option_CheckChanged"/>
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <RadioButton GroupName="shuntingOption" Name="selectJoinSplit" VerticalAlignment="Center"
                         Content="Join and split" MinWidth="120" IsCheckedChanged="Option_CheckChanged" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <RadioButton GroupName="shuntingOption" Name="aiRequestPassRed" VerticalAlignment="Center"
                         Content="AI train request to pass red signal" IsCheckedChanged="Option_CheckChanged" />
        </StackPanel>
        <StackPanel Orientation="Horizontal">
            <RadioButton GroupName="shuntingOption" Name="selectBlowHorn" VerticalAlignment="Center"
                         Content="Blow horn for" MinWidth="120" IsCheckedChanged="Option_CheckChanged" />
            <TextBox Name="blowHornSeconds" KeyDown="OnKeyDownHandler" TextChanged="TwoDigits_TextChanged"/>
            <Label Content="seconds.  11 = American horn sequence."/>
        </StackPanel>
        <Separator/>
        <StackPanel Orientation="Horizontal">
            <Label Content="Wait time code as decimal ="/>
            <Label Name="WaitTimeDecimal" Content="00000"/>
            <Label Content="hexadecimal ="/>
            <Label Name="WaitTimeHexadecimal" Content="0000"/>
        </StackPanel>
        <Separator/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="20">
            <Button Content=" OK " Name="buttonOK" Click="ButtonOK_Click"/>
            <Button Content=" Cancel " Name="buttonCancel" Click="ButtonCancel_Click" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
