<Window x:Class="Orts.TimetableEditor.Views.StationParametersView"
        xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StationParametersView" Height="450" SizeToContent="Width" WindowStartupLocation="CenterOwner">
    <Grid ColumnDefinitions="150,340" RowDefinitions="36,*,40">
        <ListBox ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}" Grid.RowSpan="2">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Name}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Column="1" Orientation="Horizontal" IsVisible="{Binding CommandsVisible}" Margin="4 0">
            <TextBlock Text="Command:" VerticalAlignment="Center"/>
            <ComboBox ItemsSource="{Binding PossibleCommands}" SelectedItem="{Binding SelectedPossibleCommand}" Width="150" Margin="5 0" VerticalAlignment="Center"/>
            <Button Content="Cmd+" Command="{Binding AddCommand}" ToolTip.Tip="Add Command" VerticalAlignment="Center"/>
            <Button Content="Cmd-" Command="{Binding RemoveCommand}" ToolTip.Tip="Remove Command" VerticalAlignment="Center" Margin="4 0"/>
        </StackPanel>
        <ListBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding SelectedStation.Commands}" SelectedItem="{Binding SelectedCommand}" IsVisible="{Binding CommandsVisible}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding Name}" VerticalAlignment="Center"/>
                        <TextBlock Text="=" Margin="2 0" IsVisible="{Binding HasValue}" VerticalAlignment="Center"/>
                        <TextBox Text="{Binding Value}" Width="80" IsVisible="{Binding HasValue}"/>
                    </StackPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
        <StackPanel Grid.Row="2" Grid.ColumnSpan="2" HorizontalAlignment="Center" Orientation="Horizontal">
            <Button Content="Cancel" IsCancel="True" Width="70" Margin="20 5" Click="Cancel_Click" HorizontalContentAlignment="Center"/>
            <Button Content="OK" Width="70" Margin="20 5" Click="OK_Click" HorizontalContentAlignment="Center"/>
        </StackPanel>
    </Grid>
</Window>
