  <!-- Copy web content and compile effects (replaces PostBuildActions.bat) -->
  <PropertyGroup>
    <OrtsShaderProfile Condition="'$(OrtsGraphicsBackend)' == 'Vulkan'">Vulkan</OrtsShaderProfile>
    <OrtsShaderProfile Condition="'$(OrtsGraphicsBackend)' == 'DX12'">DirectX_12</OrtsShaderProfile>
    <OrtsShaderProfile Condition="'$(OrtsGraphicsBackend)' == 'DesktopGL4'">OpenGL</OrtsShaderProfile>
    <OrtsProgramDir>$(MSBuildThisFileDirectory)../../Program/</OrtsProgramDir>
  </PropertyGroup>
  <ItemGroup>
    <OrtsEffect Include="Content/*.fx" />
    <OrtsWebContent Include="Viewer3D/WebServices/Web/**/*" />
  </ItemGroup>
  <Target Name="OrtsCopyWebContent" AfterTargets="Build">
    <RemoveDir Directories="$(OrtsProgramDir)Content/Web" />
    <Copy SourceFiles="@(OrtsWebContent)" DestinationFiles="@(OrtsWebContent->'$(OrtsProgramDir)Content/Web/%(RecursiveDir)%(Filename)%(Extension)')" />
    <Delete Files="$(OrtsProgramDir)RunActivityLAA.exe;$(OrtsProgramDir)RunActivityLAA.dll" />
  </Target>
  <!-- Optional locally built MonoGame native runtime, e.g. with fixes not yet in a release:
       dotnet build -p:OrtsMgRuntimeOverride=/path/to/libmgruntime.so -->
  <Target Name="OrtsCopyMgRuntimeOverride" AfterTargets="Build" Condition="'$(OrtsMgRuntimeOverride)' != ''">
    <Error Condition="!Exists('$(OrtsMgRuntimeOverride)')" Text="OrtsMgRuntimeOverride '$(OrtsMgRuntimeOverride)' does not exist" />
    <Copy SourceFiles="$(OrtsMgRuntimeOverride)" DestinationFolder="$(OrtsProgramDir)" />
  </Target>
  <Target Name="OrtsRestoreTools" AfterTargets="Build">
    <Exec Command="dotnet tool restore" WorkingDirectory="$(MSBuildThisFileDirectory)../.." />
  </Target>
  <Target Name="OrtsCompileEffects" AfterTargets="OrtsRestoreTools" Inputs="@(OrtsEffect)" Outputs="@(OrtsEffect->'$(OrtsProgramDir)Content/%(Filename).mgfx')">
    <Exec Command="dotnet tool run mgfxc &quot;%(OrtsEffect.FullPath)&quot; &quot;$(OrtsProgramDir)Content/%(OrtsEffect.Filename).mgfx&quot; /Profile:$(OrtsShaderProfile)" WorkingDirectory="$(MSBuildThisFileDirectory)../.." />
  </Target>
